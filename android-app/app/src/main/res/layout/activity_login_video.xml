<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_strava_gradient">

    <!-- Small Video Background - Top Right Corner -->
    <VideoView
        android:id="@+id/login_video"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:scaleType="centerCrop"
        android:rotation="45"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Login Content - Centered -->
    <LinearLayout
        android:id="@+id/login_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@drawable/bg_strava_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ShiftSync"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-light"
            android:layout_marginBottom="16dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect Workers • Find Opportunities"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginBottom="48dp"
            android:gravity="center"/>

        <!-- Email Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="EMAIL"
            android:textColorHint="#888888"
            app:boxBackgroundColor="#1E1E1E"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#FC4C02"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="#FC4C02"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#FC4C02">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/email_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:padding="20dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:hint="PASSWORD"
            android:textColorHint="#888888"
            app:boxBackgroundColor="#1E1E1E"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#FC4C02"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="#FC4C02"
            app:startIconDrawable="@android:drawable/ic_lock_lock"
            app:startIconTint="#FC4C02"
            app:endIconMode="password_toggle"
            app:endIconTint="#FC4C02">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:padding="20dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Worker/Employer Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/login_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="#FC4C02"
            app:tabSelectedTextColor="#FC4C02"
            app:tabTextColor="#CCCCCC"
            app:tabRippleColor="@android:color/transparent"
            app:tabIndicatorHeight="4dp"
            app:tabIndicatorFullWidth="false" />

        <!-- Login Button -->
        <Button
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#FC4C02"
            android:text="LOG IN"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:cornerRadius="12dp"
            app:elevation="4dp" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/loading_indicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:indeterminateTint="#FC4C02"
            android:visibility="gone" />

        <!-- Create Profile Link -->
        <TextView
            android:id="@+id/create_profile_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:text="CREATE PROFILE"
            android:textColor="#FC4C02"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
