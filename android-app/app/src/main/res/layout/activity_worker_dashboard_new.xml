<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/header_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_indigo"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="92dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/profile_icon"
                        android:layout_width="@dimen/avatar_medium"
                        android:layout_height="@dimen/avatar_medium"
                        android:background="@drawable/bg_pill_glass">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="Profile"
                            android:src="@drawable/ic_person_modern"
                            app:tint="@android:color/white" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/welcome_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.85"
                            android:text="@string/greeting_hindi"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/worker_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Worker"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/notification_icon"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:background="@drawable/bg_pill_glass"
                        android:clickable="true"
                        android:contentDescription="Notifications"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bell_modern"
                            app:tint="@android:color/white" />

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_notification_dot" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/header_sign_out"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_status_dark"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/action_logout"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/worker_dashboard_overview"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_headline"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.9"
                    android:text="@string/worker_dashboard_subtitle"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/worker_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_status_dark"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/available_for_work"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-64dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/earnings_hero_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_earnings_card"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:alpha="0.85"
                                android:text="@string/worker_stat_lifetime"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.85"
                                android:text="@string/view_all_earnings"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lifetime_earnings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="&#8377;0"
                            android:textColor="@android:color/white"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.8"
                                    android:text="@string/worker_stat_total"
                                    android:textColor="@android:color/white"
                                    android:textSize="@dimen/text_caption" />

                                <TextView
                                    android:id="@+id/today_earnings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="&#8377;0"
                                    android:textColor="@android:color/white"
                                    android:textSize="@dimen/text_subtitle"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.8"
                                    android:text="@string/worker_stat_month"
                                    android:textColor="@android:color/white"
                                    android:textSize="@dimen/text_caption" />

                                <TextView
                                    android:id="@+id/monthly_earnings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="&#8377;0"
                                    android:textColor="@android:color/white"
                                    android:textSize="@dimen/text_subtitle"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.8"
                                    android:text="Shifts done"
                                    android:textColor="@android:color/white"
                                    android:textSize="@dimen/text_caption" />

                                <TextView
                                    android:id="@+id/completed_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="0"
                                    android:textColor="@android:color/white"
                                    android:textSize="@dimen/text_subtitle"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/quick_actions"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:columnCount="2"
                    android:rowCount="2">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/find_work_card"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/quick_action_card_height"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:cardCornerRadius="@dimen/card_corner_radius_large"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_surface_panel_soft"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <FrameLayout
                                android:layout_width="@dimen/icon_card_action"
                                android:layout_height="@dimen/icon_card_action"
                                android:background="@drawable/bg_icon_container_primary">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_search_modern"
                                    app:tint="@color/brand_primary" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Find Work"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.75"
                                android:text="Browse live openings"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/my_shifts_card"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/quick_action_card_height"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:cardCornerRadius="@dimen/card_corner_radius_large"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_surface_panel_soft"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <FrameLayout
                                android:layout_width="@dimen/icon_card_action"
                                android:layout_height="@dimen/icon_card_action"
                                android:background="@drawable/bg_icon_container_emerald">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_calendar_modern"
                                    app:tint="@color/status_success" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="My Shifts"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.75"
                                android:text="Assigned and applied"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/profile_card"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/quick_action_card_height"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:cardCornerRadius="@dimen/card_corner_radius_large"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_surface_panel_soft"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <FrameLayout
                                android:layout_width="@dimen/icon_card_action"
                                android:layout_height="@dimen/icon_card_action"
                                android:background="@drawable/bg_icon_container_indigo">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_person_modern"
                                    app:tint="@color/brand_secondary" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Profile"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.75"
                                android:text="Skills and preferences"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/help_card"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/quick_action_card_height"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="4dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:cardCornerRadius="@dimen/card_corner_radius_large"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_surface_panel_soft"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <FrameLayout
                                android:layout_width="@dimen/icon_card_action"
                                android:layout_height="@dimen/icon_card_action"
                                android:background="@drawable/bg_icon_container_violet">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_sparkles_modern"
                                    app:tint="@color/shift_night" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="AI Advisor"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.75"
                                android:text="Suggestions and guidance"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </GridLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/card_corner_radius_large"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_surface_panel"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/card_inner_padding">

                        <FrameLayout
                            android:layout_width="@dimen/icon_card_action"
                            android:layout_height="@dimen/icon_card_action"
                            android:background="@drawable/bg_icon_container_emerald">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_clock_modern"
                                app:tint="@color/status_success" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/worker_stat_status"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_subtitle"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/availability_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/available_today"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_body" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/availability_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minHeight="@dimen/touch_target_min"
                            android:thumbTint="@color/brand_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/recent_activity"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/card_corner_radius_large"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_surface_panel"
                        android:orientation="vertical"
                        android:padding="@dimen/card_inner_padding">

                        <TextView
                            android:id="@+id/recent_activity_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="@string/no_recent_activity"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav_floating"
        android:elevation="0dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="@dimen/icon_nav"
                android:layout_height="@dimen/icon_nav"
                android:contentDescription="Home"
                android:src="@drawable/ic_home_modern"
                app:tint="@color/nav_selected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_worker_home"
                android:textColor="@color/nav_selected"
                android:textSize="@dimen/text_nav_label"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_find_work"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="@dimen/icon_nav"
                android:layout_height="@dimen/icon_nav"
                android:contentDescription="Find Work"
                android:src="@drawable/ic_search_modern"
                app:tint="@color/nav_unselected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Find"
                android:textColor="@color/nav_unselected"
                android:textSize="@dimen/text_nav_label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_my_shifts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="@dimen/icon_nav"
                android:layout_height="@dimen/icon_nav"
                android:contentDescription="My Shifts"
                android:src="@drawable/ic_calendar_modern"
                app:tint="@color/nav_unselected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_worker_shifts"
                android:textColor="@color/nav_unselected"
                android:textSize="@dimen/text_nav_label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="@dimen/icon_nav"
                android:layout_height="@dimen/icon_nav"
                android:contentDescription="Profile"
                android:src="@drawable/ic_person_modern"
                app:tint="@color/nav_unselected" />

