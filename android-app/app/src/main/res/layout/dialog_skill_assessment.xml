<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your Current Skills"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_color"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/current_skills_input"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="e.g. Painting, Carpentry, Plumbing"
        android:inputType="text"
        android:gravity="top"
        android:lines="3"
        android:padding="12dp"
        android:background="@drawable/bg_input"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Skills You Want to Learn (Optional)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_color"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/target_skills_input"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="e.g. Electrical Work, Masonry"
        android:inputType="text"
        android:gravity="top"
        android:lines="3"
        android:padding="12dp"
        android:background="@drawable/bg_input"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Years of Experience (Optional)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_color"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/experience_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="e.g. 2, 5, 10"
        android:inputType="number"
        android:padding="12dp"
        android:background="@drawable/bg_input"
        android:textSize="14sp" />

</LinearLayout>
