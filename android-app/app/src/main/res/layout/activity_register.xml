<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Big Back Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:layout_margin="16dp"
        android:text="BACK"
        android:textColor="@color/brand_orange"
        android:textSize="@dimen/text_button"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_menu_revert"
        app:iconSize="32dp"
        app:iconTint="@color/brand_orange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/register_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S"
            android:textColor="@color/white"
            android:background="@drawable/logo_bg"
            android:textSize="44sp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="JOIN SHIFTSYNC"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/register_header">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="40dp"
            app:cardBackgroundColor="@color/brand_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Role Tabs -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/register_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@android:color/transparent"
                    app:tabIndicatorColor="@color/brand_orange"
                    app:tabSelectedTextColor="@color/brand_orange"
                    app:tabTextColor="@color/text_medium"
                    app:tabIndicatorHeight="4dp"
                    app:tabIndicatorFullWidth="false"
                    app:tabTextAppearance="@style/TextAppearance.ShiftSync.Toolbar" />

                <!-- Full Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/name_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="FULL NAME"
                    android:textColorHint="#E0E0E0"
                    app:boxBackgroundColor="#2A2A2A"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/brand_orange"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/brand_orange"
                    app:startIconDrawable="@android:drawable/ic_menu_edit"
                    app:startIconTint="@color/brand_orange">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/name_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:padding="18dp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/reg_email_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="EMAIL"
                    android:textColorHint="#E0E0E0"
                    app:boxBackgroundColor="#2A2A2A"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/brand_orange"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/brand_orange"
                    app:startIconDrawable="@android:drawable/ic_dialog_email"
                    app:startIconTint="@color/brand_orange">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reg_email_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:padding="18dp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phone_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="PHONE"
                    android:textColorHint="#E0E0E0"
                    app:boxBackgroundColor="#2A2A2A"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/brand_orange"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/brand_orange"
                    app:startIconDrawable="@android:drawable/stat_sys_phone_call"
                    app:startIconTint="@color/brand_orange">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phone_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:padding="18dp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Company -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/company_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="COMPANY"
                    android:textColorHint="#E0E0E0"
                    app:boxBackgroundColor="#2A2A2A"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/brand_orange"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/brand_orange"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="@color/brand_orange">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/company_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:padding="18dp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/reg_password_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="PASSWORD"
                    android:textColorHint="#E0E0E0"
                    app:boxBackgroundColor="#2A2A2A"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/brand_orange"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/brand_orange"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#BDBDBD"
                    app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                    app:startIconTint="@color/brand_orange">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reg_password_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:padding="18dp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Big Create Profile button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/register_button"
                    style="@style/Widget.ShiftSync.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_large"
                    android:layout_marginTop="28dp"
                    android:text="CREATE PROFILE"
                    android:textSize="@dimen/text_button"
                    android:letterSpacing="0.05" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
