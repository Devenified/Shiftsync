<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxStrokeColor="@color/brand_orange"
        app:hintTextColor="@color/text_medium"
        android:textColorHint="@color/text_medium">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/work_company_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_medium"
            android:hint="Company Name" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxStrokeColor="@color/brand_orange"
        app:hintTextColor="@color/text_medium"
        android:textColorHint="@color/text_medium">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/work_position_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_medium"
            android:hint="Position" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:boxStrokeColor="@color/brand_orange"
            app:hintTextColor="@color/text_medium"
            android:textColorHint="@color/text_medium">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/work_start_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="date"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_medium"
                android:hint="Start Date" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:boxStrokeColor="@color/brand_orange"
            app:hintTextColor="@color/text_medium"
            android:textColorHint="@color/text_medium">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/work_end_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="date"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_medium"
                android:hint="End Date" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxStrokeColor="@color/brand_orange"
        app:hintTextColor="@color/text_medium"
        android:textColorHint="@color/text_medium">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/work_description_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_medium"
            android:hint="Work Description" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
