<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_hero_gradient"
        app:menu="@menu/menu_toolbar_sign_out"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="#FFFFFF"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
        app:title="Find Workers"
        app:titleTextColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:background="@drawable/bg_surface_panel"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginHorizontal="@dimen/screen_padding_horizontal">

        <TextView
            android:id="@+id/results_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search for talent"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ShiftSync.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Search by name, skill, location"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search_modern">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.ShiftSync.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="Skill"
                app:startIconDrawable="@drawable/ic_sparkles_modern">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/skill_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.ShiftSync.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Location"
                app:startIconDrawable="@drawable/ic_location_modern">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/location_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/available_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Available only"
            android:textColor="@color/text_medium"
            app:thumbTint="@color/brand_primary"
            app:trackTint="@color/bg_dim" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/rating_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_rating_any"
                    style="@style/Widget.ShiftSync.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Any rating" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_rating_3"
                    style="@style/Widget.ShiftSync.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3.0+" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_rating_4"
                    style="@style/Widget.ShiftSync.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.0+" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_rating_45"
                    style="@style/Widget.ShiftSync.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5+" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/sort_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_rating"
                    style="@style/Widget.ShiftSync.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Top rated" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_shifts"
                    style="@style/Widget.ShiftSync.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Most shifts" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_experience"
                    style="@style/Widget.ShiftSync.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Experience" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sort_available"
                    style="@style/Widget.ShiftSync.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available first" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_search"
            style="@style/Widget.ShiftSync.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_standard"
            android:layout_marginTop="14dp"
            android:text="Search"
            app:icon="@drawable/ic_search_modern"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/screen_padding_horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_workers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_worker_search" />

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_surface_panel_soft"
            android:gravity="center"
            android:padding="32dp"
            android:text="No workers match your search.\nTry a different skill or location."
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_primary"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
