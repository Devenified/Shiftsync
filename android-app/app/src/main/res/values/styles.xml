<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary filled action (vibrant orange) -->
    <style name="Widget.ShiftSync.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height_standard</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="backgroundTint">@color/brand_orange</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Secondary outlined -->
    <style name="Widget.ShiftSync.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_standard</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="strokeColor">@color/brand_orange</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/brand_orange</item>
        <item name="backgroundTint">#FFFFFF</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- Large dashboard buttons -->
    <style name="Widget.ShiftSync.Button.DashboardPrimary" parent="Widget.ShiftSync.Button.Primary">
        <item name="android:layout_height">@dimen/button_height_dashboard</item>
        <item name="android:minHeight">@dimen/button_height_dashboard</item>
    </style>

    <style name="Widget.ShiftSync.Button.DashboardOutlined" parent="Widget.ShiftSync.Button.Outlined">
        <item name="android:layout_height">@dimen/button_height_dashboard</item>
        <item name="android:minHeight">@dimen/button_height_dashboard</item>
    </style>

    <!-- Logout button (red) -->
    <style name="Widget.ShiftSync.Button.Logout" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">#EF4444</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Accessible text input (bright) -->
    <style name="Widget.ShiftSync.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#FFFFFF</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxStrokeColor">@color/brand_orange</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintTextColor">@color/brand_orange</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.ShiftSync.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.ShiftSync.Toolbar</item>
    </style>

    <style name="TextAppearance.ShiftSync.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
