<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============= BUTTONS ============= -->

    <style name="Widget.ShiftSync.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height_standard</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">@color/ripple_on_dark</item>
    </style>

    <style name="Widget.ShiftSync.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height_standard</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/brand_secondary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="iconTint">#FFFFFF</item>
    </style>

    <style name="Widget.ShiftSync.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_standard</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="backgroundTint">#FFFFFF</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="iconTint">@color/brand_primary</item>
        <item name="rippleColor">@color/ripple_color</item>
    </style>

    <style name="Widget.ShiftSync.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height_standard</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="rippleColor">@color/ripple_color</item>
    </style>

    <style name="Widget.ShiftSync.Button.DashboardPrimary" parent="Widget.ShiftSync.Button.Primary">
        <item name="android:layout_height">@dimen/button_height_dashboard</item>
        <item name="android:minHeight">@dimen/button_height_dashboard</item>
    </style>

    <style name="Widget.ShiftSync.Button.DashboardOutlined" parent="Widget.ShiftSync.Button.Outlined">
        <item name="android:layout_height">@dimen/button_height_dashboard</item>
        <item name="android:minHeight">@dimen/button_height_dashboard</item>
    </style>

    <style name="Widget.ShiftSync.Button.Logout" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@color/status_error</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">@color/ripple_on_dark</item>
    </style>

    <!-- ============= TEXT INPUTS ============= -->

    <style name="Widget.ShiftSync.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card_background_tinted</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="startIconTint">@color/brand_primary</item>
        <item name="endIconTint">@color/brand_primary</item>
    </style>

    <!-- ============= TOOLBAR / TEXT ============= -->

    <style name="Widget.ShiftSync.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.ShiftSync.Toolbar</item>
    </style>

    <style name="TextAppearance.ShiftSync.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ShiftSync.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.ShiftSync.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <style name="TextAppearance.ShiftSync.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <style name="TextAppearance.ShiftSync.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.ShiftSync.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="TextAppearance.ShiftSync.Money" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textColor">@color/status_money</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_money_large</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- ============= CARDS ============= -->

    <style name="Widget.ShiftSync.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="Widget.ShiftSync.Card.Flat" parent="Widget.ShiftSync.Card">
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_border_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.ShiftSync.Card.Glass" parent="Widget.ShiftSync.Card">
        <item name="cardBackgroundColor">@color/glass_surface</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.ShiftSync.Card.Hero" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius_large</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ============= CHIPS / PILLS ============= -->

    <style name="Widget.ShiftSync.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/card_background_tinted</item>
        <item name="chipStrokeColor">@color/card_border_light</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipCornerRadius">16dp</item>
    </style>

    <!-- ============= BOTTOM NAV ============= -->

    <style name="Widget.ShiftSync.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_icon_tint</item>
        <item name="itemTextColor">@color/bottom_nav_text_color</item>
        <item name="itemRippleColor">@color/ripple_color</item>
        <item name="backgroundTint">@color/nav_background</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- ============= SECTION HEADER ============= -->

    <style name="TextAppearance.ShiftSync.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
</resources>
