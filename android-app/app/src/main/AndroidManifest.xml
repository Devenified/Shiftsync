<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".ShiftSyncApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Verson1"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginVideoActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".EmployerDashboardActivity" />
        <activity android:name=".WorkerDashboardActivity" />
        <activity android:name=".WorkerDashboardNewActivity" />
        <activity android:name=".WorkerDashboardCleanActivity" />
        <activity android:name=".WorkerDashboardCompleteActivity" />
        <activity android:name=".WorkerOpenShiftsActivity" />
        <activity android:name=".WorkerMyShiftsActivity" />
        <activity android:name=".WorkerProfileActivity" />
        <activity android:name=".WorkerProfileEnhancedActivity" />
        <activity android:name=".EditProfileActivity" />
        <activity android:name=".EmployerPostShiftActivity" />
        <activity android:name=".EmployerManageShiftsActivity" />
        <activity android:name=".EmployerFindWorkersActivity" />
        <activity android:name=".EmployerProfileActivity" />
        <activity android:name=".AISkillAdvisorActivity" />
        <activity android:name=".EmployerAIHelperActivity" />
        <activity android:name=".PostShiftActivity" />
        <activity android:name=".RequestSwapActivity" />
        <activity android:name=".RequestLeaveActivity" />
        <activity android:name=".NotificationsActivity" />
        <activity android:name=".WorkerPublicProfileActivity" />
        <activity android:name=".WorkerEarningsActivity" />
        <activity
            android:name=".CrashScreenActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light" />
        <activity android:name=".MainActivity" />

    </application>

</manifest>
